function CoachTab({ safe, msgs, setMsgs, api }) {
  const [input, setInput] = useState("");
  const [typing, setTyping] = useState(false);
  const endRef = useRef(null);
  const listRef = useRef(null);
  useEffect(() => { const el = listRef.current; if (el) el.scrollTo({ top: el.scrollHeight, behavior: "smooth" }); }, [msgs, typing]);

  const ask = (text) => {
    if (!text.trim() || typing) return;
    setMsgs((m) => [...m, { role: "user", text }]);
    setInput("");
    setTyping(true);
    setTimeout(() => {
      setMsgs((m) => [...m, { role: "ai", ...respond(text, safe) }]);
      setTyping(false);
    }, 900);
  };

  if (api) api.current = {
    setInput, ask,
    pushAi: (m) => { setTyping(true); setTimeout(() => { setMsgs((x) => [...x, { role: "ai", ...m }]); setTyping(false); }, 900); },
  };
  return (
    <div className="flex flex-col h-full">
      <div ref={listRef} data-scroll className="flex-1 overflow-y-auto no-scrollbar p-3 pt-7 space-y-3 bg-slate-50">
        <div className="text-center text-[10.5px] text-slate-400">Today</div>
        {msgs.map((m, i) => <Bubble key={i} m={m} />)}
        {typing && (
          <div className="flex gap-2 items-center">
            <CoachMark size={28} onDark={false} />
            <div className="bg-white rounded-2xl px-4 py-3 flex gap-1 border border-slate-100">
              {[0, 1, 2].map((i) => <span key={i} className="w-1.5 h-1.5 rounded-full bg-slate-400 animate-bounce" style={{ animationDelay: i * 0.15 + "s" }} />)}
            </div>
          </div>
        )}
        <div ref={endRef} />
      </div>
      <div className="bg-white border-t border-slate-200 pt-2 pb-2">
        <div className="flex gap-2 overflow-x-auto no-scrollbar px-3 pb-2">
          {CHIPS.map((c, i) => (
            <button key={i} onClick={() => ask(c)}
              className="shrink-0 max-w-[230px] text-left text-[11.5px] leading-tight font-medium text-sb bg-emerald-50 border border-emerald-200 rounded-2xl px-3 py-2 active:scale-95 transition">
              {["🚗 ", "🛒 ", "☕ "][i]}{c}
            </button>
          ))}
