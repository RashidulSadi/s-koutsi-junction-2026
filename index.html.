function LiquiditySlider({ repair = 400, bill = 150 }) {
  const BILL = bill, PAYDAY = 10, RATE = 0.09; // est. statutory late interest (reference rate + 7 pp)
  const demo = useContext(DemoCtx);
  const [d, setD] = useState(demo.liqDays != null ? Math.round(demo.liqDays) : PAYDAY);
  useEffect(() => { if (demo.liqDays != null) setD(Math.round(demo.liqDays)); }, [demo.liqDays]);
  const leftIfPaid = D.life.avg - repair - BILL;
  const interest = BILL * RATE * (d / 365);
  const fee = d > 14 ? 5 : 0;
  const cost = interest + fee;
  const loanCost = 12 + BILL * 0.15 * (d / 365); // illustrative quick-loan setup fee + capped 15% interest
  const zone = d === 0 ? "now" : d <= 14 ? "safe" : "fee";
  return (
    <WidgetShell title="⚡ Tactical Liquidity Slider" tag={`Helen · ${fmt(BILL)}`}>
      <div className="grid grid-cols-2 gap-1.5 mb-3">
        <button data-demo="liq-friday" onClick={() => setD(0)} className={`text-left rounded-xl border px-2.5 py-2 transition ${d === 0 ? "border-rose-300 bg-rose-50" : "border-slate-200 bg-white"}`}>
          <div className="text-[11.5px] font-bold text-ink">Pay Friday</div>
          <div className={`text-[10px] ${leftIfPaid < 50 ? "text-rose-600" : "text-slate-500"}`}>Leaves {fmt(leftIfPaid, 2)} in buffer</div>
        </button>
        <button data-demo="liq-buffer" onClick={() => setD(14)} className={`text-left rounded-xl border px-2.5 py-2 transition ${d >= 14 ? "border-emerald-400 bg-emerald-50" : "border-slate-200 bg-white"}`}>
          <div className="text-[11.5px] font-bold text-ink">14-Day Reminder Buffer</div>
          <div className="text-[10px] text-slate-500">Max €5 fee · paid after payday · credit safe</div>
        </button>
      </div>
      <div className="text-[11.5px] text-slate-600 mb-2">Delay the electricity bill by <b className="text-ink">{d} days</b></div>
      <Range value={d} min={0} max={21} onChange={setD} accent={zone === "fee" ? "#f59e0b" : "#00A550"} />
      <div className="relative h-5 text-[9.5px] text-slate-500 mt-0.5">
        <span className="absolute left-0">Due Fri</span>
        <span className="absolute" style={{ left: `${(PAYDAY / 21) * 100 - 8}%` }}>💰 Payday</span>
        <span className="absolute" style={{ left: `${(14 / 21) * 100 - 4}%` }}>14 d</span>
      </div>
      <div className="flex h-1.5 rounded-full overflow-hidden mb-3">
        <div className="bg-emerald-400" style={{ width: `${(14 / 21) * 100}%` }} />
        <div className="bg-amber-400 flex-1" />
      </div>
      <div className="grid grid-cols-2 gap-2">
        <div className={`rounded-xl p-2.5 ${zone === "fee" ? "bg-amber-50" : "bg-emerald-50"}`}>
          <div className="text-[10px] text-slate-500">Cost of waiting</div>
          <div className="text-[20px] font-extrabold text-ink tabular-nums">{fmt(cost, 2)}</div>
          <div className="text-[9.5px] text-slate-500">interest {fmt(interest, 2)}{fee ? " + €5 reminder" : ""}</div>
        </div>
        <div className="rounded-xl p-2.5 bg-rose-50">
          <div className="text-[10px] text-slate-500">Quick loan instead</div>
          <div className="text-[20px] font-extrabold text-rose-600 tabular-nums">{fmt(loanCost, 2)}</div>
          <div className="text-[9.5px] text-slate-500">fees + up to 15% p.a.</div>
        </div>
      </div>
      <div className={`mt-2.5 text-[11.5px] rounded-lg px-2.5 py-2 ${zone === "fee" ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800"}`}>
        {zone === "now" && "Paying today keeps everything clean — but squeezes this week."}
        {zone === "safe" && <>✅ Within 14 days: under Finnish debt collection law a reminder can't be sent yet, so <b>no €5 fee</b> — only a few cents of late interest.</>}
        {zone === "fee" && <>⚠️ After 14 days Helen may send a reminder with the statutory <b>€5 fee</b>. Still cheaper than a loan, but pay by day 14.</>}
      </div>
      <div role="note" data-demo="liq-note" className="mt-2.5 flex gap-2 rounded-xl border-l-4 border-sky-500 bg-sky-50 px-2.5 py-2">
        <ShieldCheck className="w-4 h-4 shrink-0 mt-0.5 text-sky-600" strokeWidth={2} />
        <div className="text-[11px] leading-snug text-sky-900">
          <b>Note:</b> Using the 14-day €5 reminder window protects your credit score (<i>luottotiedot</i>). A late bill or a reminder never creates a payment default. That takes <b>60+ days</b> of non-payment plus a formal notice, or a court ruling.
