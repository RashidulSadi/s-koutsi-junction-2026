function respond(raw, safe) {
  const q = raw.toLowerCase();
  const has = (...w) => w.some((x) => q.includes(x));
  if (has("car", "repair", "helen", "electric", "sähkö", "lasku", "bill", "korjaus") || q === CHIPS[0].toLowerCase()) {
    const amounts = [...raw.matchAll(/€\s?(\d+(?:[.,]\d+)?)/g)].map((m) => parseFloat(m[1].replace(",", ".")));
    const bill = amounts.find((a) => a === 150) || 150;
    const repair = amounts.find((a) => a !== bill) || 400;
    const left = D.life.avg - repair;
    return {
      text: `Ugh, a surprise ${fmt(repair)} repair is stressful, ${D.name} — let's sort it out calmly. 💚\n\nThis is exactly what your Life Happens buffer is for: ${fmt(D.life.avg)}/mo, untouched in September. The repair ${left >= 0 ? `fits, leaving ${fmt(left, 2)}` : `goes ${fmt(-left, 2)} past it`}. But paying Helen's ${fmt(bill)} on Friday as well would leave ${fmt(left - bill, 2)} — basically nothing.\n\nNo quick loan needed. In Finland a payment reminder can only come 14+ days after the due date, and its fee is capped at €5 — so you can safely move the bill past payday:`,
      widget: "liquidity", props: { repair, bill },
    };
  }
  if (has("only have", "left for food", "€50", "50 left", "punalap", "red label", "discount", "alennus"))
    return {
      text: `Got it — €50 for the week. Totally doable. 🛒\n\nI looked at your S-Group trips: ${D.grocery.sgroup.prisma.tx} at Prisma and ${D.grocery.sgroup.alepa.tx} at Alepa. Your last Alepa run was ${D.lastAlepa} — prime full-price hours.\n\nAfter 21:00, many S-Group stores cut red-label (punalappu) items from −30% to −60%. Same €50, more than double the food if you shop late and smart:`,
      widget: "sniper",
    };
  if (has("wolt", "cafe", "café", "coffee", "kahvi", "restaurant", "ravintola", "takeaway", "delivery"))
    return {
      text: `Love this question. ☕ Your restaurant & delivery spend averages ${fmt(D.flex.breakdown.Restaurants)}/mo, but September ran hot at ${fmt(D.restaurantsSep)} (6 visits in 12 days).\n\nA 20% trim is barely noticeable day to day — but watch what it compounds into, plus the S-Bonus you earn when that money goes to S-Group groceries instead:`,
      widget: "cutter",
