  if (has("basket", "kori", "bedrock", "flex", "life happens"))
    return { text: `Your 3 baskets: 🪨 Bedrock ${fmt(D.bedrock.avg)} (62%), 🩹 Life Happens ${fmt(D.life.avg)} (18%), 🌊 Flex Zone ${fmt(D.flex.avg)} (20%). Bedrock is predictable, Life Happens needs a buffer, and Flex is where you have full control.` };
  if (has("hi", "hello", "hei", "moi", "terve", "hey"))
    return { text: `Moi ${D.name}! 😊 Ask me anything about your money — bills, food, savings, or “can I afford…?”. Or tap a prompt below.` };
  return { text: `Good question! Here's how it looks with your numbers: you earn ~${fmt(D.incomeLatest)}/mo, spend ~${fmt(D.spendAvg)}, and invest ${fmt(D.investAvg)}. Your Safe-to-Spend this week is ${fmt(safe)}.\n\nTry asking about groceries, savings, a specific bill, or “what if I cut…” and I'll run the numbers.` };
}

