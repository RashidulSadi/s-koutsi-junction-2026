          <button key={k} onClick={() => setBase(k)} className={`flex-1 text-[10.5px] font-semibold rounded-lg py-1.5 ${base === k ? "bg-white shadow text-ink" : "text-slate-500"}`}>{l}</button>
        ))}
      </div>
      <div className="flex justify-between text-[11px] text-slate-600"><span>Cut restaurants & delivery by</span><b className="text-ink">{cut}%</b></div>
      <Range value={cut} min={0} max={50} onChange={setCut} />
