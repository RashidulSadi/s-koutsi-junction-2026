/* ---------------- Auto-play demo (outside the phone) ---------------- */
const DEMO_LEN = 45;
const DEMO_QUESTION = "How do I survive this €231 repair and still pay my €150 Helen electricity bill?";
const STEPS = [
  [0, "1 · The 3 Baskets — where Aino's money goes"],
  [10, "2 · Asking S-Koutsi for help"],
  [15, "3 · Tactical Liquidity — move the bill, not the debt"],
  [28, "4 · 9 PM Punalappu Sniper"],
  [40, "5 · Full Picture via PSD2"],
];

function Cursor({ c }) {
  return (
    <div className="fixed left-0 top-0 z-[60] pointer-events-none"
      style={{ transform: `translate(${c.x}px, ${c.y}px)`, opacity: c.visible ? 1 : 0, transition: "transform 650ms cubic-bezier(.22,.9,.3,1), opacity 300ms" }}>
      <div className={`absolute -left-5 -top-5 w-10 h-10 rounded-full bg-sb/30 ${c.click ? "scale-150 opacity-0" : "scale-50 opacity-100"}`}
        style={{ transition: c.click ? "transform 450ms ease-out, opacity 450ms ease-out" : "none" }} />
      <svg width="26" height="26" viewBox="0 0 24 24" className="drop-shadow-[0_2px_4px_rgba(0,0,0,.45)] -translate-x-[3px] -translate-y-[2px]">
        <path d="M4 2.5l15 9.2-6.6 1.4 3.7 7.1-2.6 1.3-3.7-7.1L5 18.9z" fill="#fff" stroke="#0b1220" strokeWidth="1.4" strokeLinejoin="round" />
      </svg>
    </div>
  );
}

function Root() {
  const [k, setK] = useState(0);
  const [demo, setDemo] = useState({});
  const [run, setRun] = useState(null); // { t, label, done }
  const [cur, setCur] = useState({ x: 0, y: 0, visible: false, click: false });
  const tok = useRef(null);
  const coachApi = useRef({});

  const stop = () => {
    if (tok.current) { tok.current.cancelled = true; tok.current.timers.forEach(clearTimeout); cancelAnimationFrame(tok.current.raf); }
    document.querySelectorAll(".demo-hl").forEach((e) => e.classList.remove("demo-hl"));
  };
  const reset = () => { stop(); tok.current = null; setDemo({}); setRun(null); setCur((c) => ({ ...c, visible: false })); setK((x) => x + 1); };

  const play = async () => {
    reset();
    const T = { cancelled: false, timers: [], raf: 0 };
    tok.current = T;
    const chk = () => { if (T.cancelled) throw new Error("cancelled"); };
    const sleep = (ms) => new Promise((res, rej) => { T.timers.push(setTimeout(() => (T.cancelled ? rej(new Error("cancelled")) : res()), ms)); });
    const $ = (sel) => document.querySelector(`[data-demo="${sel}"]`);
    let start;
    const at = async (sec) => { const w = start + sec * 1000 - performance.now(); if (w > 0) await sleep(w); chk(); };
    const scrollTo = async (el) => {
      const c = el.closest("[data-scroll]");
      if (!c) return;
      const er = el.getBoundingClientRect(), cr = c.getBoundingClientRect();
      const top = c.scrollTop + (er.top - cr.top) - (cr.height - Math.min(er.height, cr.height * 0.85)) / 2;
      c.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
      await sleep(550);
    };
    const move = async (sel, dx = 0.5, dy = 0.5) => {
      const el = typeof sel === "string" ? $(sel) : sel; chk();
      if (!el) return null;
      await scrollTo(el);
      const r = el.getBoundingClientRect();
      setCur({ x: r.left + r.width * dx, y: r.top + r.height * dy, visible: true, click: false });
      await sleep(700);
      return el;
    };
    const click = async (sel, dx, dy) => {
      const el = await move(sel, dx, dy); if (!el) return;
      setCur((c) => ({ ...c, click: true })); el.click();
      await sleep(350); setCur((c) => ({ ...c, click: false }));
    };
    const hl = (sel, ms) => {
      const el = $(sel); if (!el) return;
      el.classList.add("demo-hl");
      T.timers.push(setTimeout(() => el.classList.remove("demo-hl"), ms));
    };
    const tween = (key, from, to, ms) => new Promise((res) => {
      const t0 = performance.now();
      const step = (t) => {
        if (T.cancelled) return res();
        const p = Math.min(1, (t - t0) / ms), e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        setDemo((d) => ({ ...d, [key]: from + (to - from) * e }));
        if (p < 1) T.raf = requestAnimationFrame(step); else res();
      };
      T.raf = requestAnimationFrame(step);
    });
    const label = (sec) => ([...STEPS].reverse().find(([s]) => sec >= s) || STEPS[0])[1];
    const ticker = setInterval(() => {
      if (T.cancelled) return clearInterval(ticker);
      if (start == null) return;
      const sec = Math.min(DEMO_LEN, (performance.now() - start) / 1000);
      setRun((r) => (r && r.done ? r : { t: sec, label: label(sec) }));
    }, 100);
    T.timers.push(ticker);

    try {
      await sleep(350); // let the fresh app mount
      start = performance.now();
      setRun({ t: 0, label: STEPS[0][1] });
      setDemo({ scenario: true });
      const r0 = document.querySelector("[data-demo='tab-baskets']").getBoundingClientRect();
      setCur({ x: r0.left + r0.width / 2, y: r0.top - 40, visible: true, click: false });

      // 1 · 3 Baskets (0–10s)
      await at(0.4); await move("safe", 0.3, 0.35); hl("safe", 2600);
      await at(3.2); await move("bedrock", 0.75, 0.15); hl("bedrock", 2200);
      await at(5.4); await move("life", 0.55, 0.12); hl("life", 2400);
      await at(7.8); await move("flex", 0.75, 0.15); hl("flex", 2200);

      // 2 · Ask the coach (10–15s)
      await at(10); await click("tab-coach");
      await at(10.9); await click("chat-input", 0.3, 0.5);
      for (let i = 1; i <= DEMO_QUESTION.length; i++) { coachApi.current.setInput(DEMO_QUESTION.slice(0, i)); await sleep(38); }
      await at(14.6); await click("send");

      // 3 · Liquidity slider (15–28s)
      setDemo((d) => ({ ...d, liqDays: 0 }));
      await at(16.8); await move("liq-friday"); hl("liq-friday", 2800);
      await at(20); await move("liq-buffer"); hl("liq-buffer", 4000);
      setCur((c) => ({ ...c, click: true })); await sleep(300); setCur((c) => ({ ...c, click: false }));
      await tween("liqDays", 0, 14, 1600);
      await at(23.5); await move("liq-note", 0.15, 0.25); hl("liq-note", 3800);

      // 4 · Punalappu Sniper (28–40s)
      await at(26.8);
      setDemo((d) => ({ ...d, sniperShare: 30 }));
      coachApi.current.pushAi({
        demoId: "sniper-insight",
        text: `💡 One more thing I spotted: you spend ${fmt(D.grocery.comp.avg, 2)}/mo at K-Group, Lidl & other stores.\n\nShift that to Prisma or Alepa after 21:00, when 30% red-label discounts double to 60%, and you could save up to ${fmt(D.grocery.comp.avg * 0.6)}/mo* — plus your Bonus level climbs from ${BONUS_LVL.toFixed(1)}% toward ${bonusPct(BONUS_SPEND + D.grocery.comp.avg).toFixed(1)}%.\n\n*if those buys are all red-label items`,
        widget: "sniper", props: { budget: 100 },
      });
      await at(28.3); await move("sniper-insight", 0.8, 0.3); hl("sniper-insight", 3800);
      await at(32.3); await move("sniper-share", 0.35, 0.75); hl("sniper-share", 3200);
      await tween("sniperShare", 30, 100, 2400);
      await at(35.5); await move("sniper-result", 0.7, 0.5); hl("sniper-result", 4000);

      // 5 · PSD2 (40–45s)
      await at(40); await click("tab-psd2");
      await at(40.9); await click("psd2-toggle");
      await at(42.4); await move("psd2-totals", 0.5, 0.6); hl("psd2-totals", 2600);
      await at(DEMO_LEN);
      clearInterval(ticker);
      setRun({ t: DEMO_LEN, label: "✅ Demo complete", done: true });
      await sleep(1200); setCur((c) => ({ ...c, visible: false }));
    } catch (e) { clearInterval(ticker); }
  };

  useEffect(() => () => stop(), []);

  const caption = run && (
    <div className="flex items-center gap-3 bg-white/10 backdrop-blur rounded-full pl-4 pr-3 py-1.5 text-white text-[12.5px] font-medium ring-1 ring-white/15">
      <span>{run.label}</span>
      <span className="w-24 h-1 rounded-full bg-white/15 overflow-hidden"><span className="block h-full bg-emerald-400" style={{ width: `${(run.t / DEMO_LEN) * 100}%` }} /></span>
      <span className="tabular-nums text-white/60 text-[11px] w-8 text-right">{Math.floor(run.t)}s</span>
    </div>
  );

  return (
    <DemoCtx.Provider value={demo}>
      <App key={k} coachApi={coachApi} caption={caption} />
      <div className="fixed top-4 right-4 z-50 flex items-center gap-2">
        <button onClick={play}
          className="rounded-full bg-white/10 hover:bg-white/20 backdrop-blur text-white text-[13px] font-semibold px-4 py-2 ring-1 ring-white/20 shadow-lg transition">
          🎬 Auto-Play Demo (45s)
        </button>
        <button onClick={reset}
          className="rounded-full bg-white/5 hover:bg-white/15 backdrop-blur text-white/80 text-[13px] font-medium px-3.5 py-2 ring-1 ring-white/15 transition">
          ↺ Reset Demo
        </button>
      </div>
      <Cursor c={cur} />
    </DemoCtx.Provider>
  );
}

createRoot(document.getElementById("root")).render(<Root />);


  </script>
