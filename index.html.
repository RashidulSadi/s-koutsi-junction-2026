function CutSavings() {
  const [cut, setCut] = useState(20);
  const [base, setBase] = useState("sep");
  const monthly = base === "sep" ? D.restaurantsSep : D.flex.breakdown.Restaurants;
  const save = monthly * (cut / 100);
  const r = 0.05 / 12;
  const fv = save * ((Math.pow(1 + r, 12) - 1) / r) * (1 + r);
  const yearRaw = save * 12;
  const bonus = (bonusFor(BONUS_SPEND + save) - bonusFor(BONUS_SPEND)) * 12; // extra Bonus if saving is spent at S-Group instead
  const total = fv + bonus;
  const months = Array.from({ length: 12 }, (_, i) => save * ((Math.pow(1 + r, i + 1) - 1) / r) * (1 + r));
  const maxM = months[11] + bonus || 1;
  return (
    <WidgetShell title="☕ Wolt & Café Cutter" tag="1-year impact">
